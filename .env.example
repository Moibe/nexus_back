# Copia este archivo a `.env` y llena los valores.

ENVIRONMENT=local
PORT=8083

# --- CORS ---
# El front llama a esta API desde su capa server (SvelteKit), no desde el
# navegador, así que esto casi no aplica. Se deja por si algún día se consume
# directo desde el browser.
# CORS_ALLOWED_ORIGINS=http://localhost:7000

# --- SQL Server ---
# La base la diseña y mantiene el DBA. Esta API solo consume sus stored
# procedures; no hay migraciones ni ORM de este lado.
#
# SQLSERVER_HOST funciona como interruptor del grupo /documentos/*: si está
# vacío, app.py NO registra ese router y esos endpoints no aparecen en Swagger
# (mejor que publicar un 503 apuntando a una base que no existe). Al llenarlo y
# reiniciar, el grupo aparece solo — sin tocar código.
#
# HOST va SIN el nombre de instancia, aunque el DBA lo entregue en la sintaxis
# de SQL Server (`host\instancia,puerto`). Con el puerto explícito la instancia
# es redundante, y la forma `host\instancia` obliga al cliente a preguntarle al
# SQL Browser en UDP 1434 — un servicio que casi siempre está cerrado en el
# firewall, así que se ve como "no responde" sin ninguna otra pista.
SQLSERVER_HOST=
# El puerto NO siempre es 1433: una instancia nombrada suele traer el suyo.
SQLSERVER_PORT=1433
# Truco para probar la conexión antes de que exista la base del proyecto: poner
# `master`, que existe en todo SQL Server. Valida host, puerto, credenciales,
# firewall y driver de una sola vez, sin depender del nombre real de la base.
SQLSERVER_DB=
# Autenticación de SQL Server, NO de Windows: esta API corre en Linux y la
# autenticación integrada exigiría montar Kerberos.
SQLSERVER_USER=
# Si la contraseña trae `#`, NO le pongas comillas ni espacio antes: python-dotenv
# sólo lo trata como comentario cuando viene precedido de espacio. Un espacio de
# más trunca la contraseña en silencio y el error parece de credenciales.
SQLSERVER_PASSWORD=
# Tiene que coincidir EXACTO con el driver instalado en el SO.
# En Ubuntu, `odbcinst -q -d` lista los disponibles.
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# El Driver 18 exige TLS por default; un SQL Server interno normalmente trae
# certificado autofirmado, por eso va en "yes".
SQLSERVER_TRUST_CERT=yes

# --- Google Document AI ---
# Se llaman directo los procesadores de Document AI. Los IDs salen de la consola
# de Google Cloud: Document AI > el procesador > pestaña de detalles.
# El ID de procesador es el hash que va en la URL después de /processors/.
DOCAI_PROJECT_ID=
DOCAI_LOCATION=us
# Versión del modelo, FIJA a propósito. Sin esto Google usa su "default",
# que él puede mover el día que promueva otra a estable — y la extracción
# dejaría de ser reproducible. Las versiones disponibles se listan con:
#   GET .../processors/<id>/processorVersions
DOCAI_VERSION_INE=pretrained-foundation-model-v1.5-pro-2025-06-20
DOCAI_PROCESADOR_INE=
IA_TIMEOUT=120

# --- Límite de subida ---
# En el server de CSI la API se expone IP:puerto directo, sin nginx delante, así
# que no hay `client_max_body_size` que proteja: el tope vive en el código.
MAX_SUBIDA_MB=20

# Ruta al JSON de la cuenta de servicio con permiso sobre Document AI.
# google-auth lee esta variable por su cuenta; el código nunca la toca.
#
# DOS REGLAS, las dos importan:
#   1. Ruta ABSOLUTA. google-auth resuelve las relativas contra el cwd del
#      proceso, no contra la raíz del proyecto. Local funciona de casualidad
#      (arrancas uvicorn parado en la raíz); con pm2 en el server el cwd puede
#      ser otro y truena con "DefaultCredentialsError: File ... not found",
#      que parece problema de credenciales y en realidad es de ruta.
#   2. El archivo va FUERA del repo. Así git no puede verlo ni con `git add -f`
#      ni si alguien edita mal el .gitignore.
#
# Local (Windows):   C:/Users/<tu-usuario>/.secretos/nexus-back-sa.json
# Server de CSI:     /etc/nexus-back/sa.json   (chmod 600, dueño = usuario de pm2)
#
# Y una llave DISTINTA por ambiente: nunca la misma en tu laptop y en el server.
# Son llaves de la misma cuenta de servicio (admite hasta 10), así que si se
# compromete la del server revocas solo esa y lo demás sigue vivo.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/tu-usuario/.secretos/nexus-back-sa.json

# --- Seguridad ---------------------------------------------------------------
# Llave compartida con el front. El navegador nunca la ve: la capa server de
# SvelteKit la manda en el header X-API-Key en cada reenvio. DEBE ser la misma
# aqui y en el .env del front. Sin ella, /ia/* y /documentos/* responden 503:
# la API falla cerrada, no abierta. Generar una con:  openssl rand -hex 32
NEXUS_API_KEY=
